<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="나날 — 나의 일정" Width="1100" Height="800" MinWidth="930" MinHeight="680" WindowStyle="None" ResizeMode="CanResizeWithGrip" Background="#F4F6F9" FontFamily="Malgun Gothic" Foreground="#191F28" UseLayoutRounding="True">
 <Window.Resources>
  <Style TargetType="Button"><Setter Property="HorizontalContentAlignment" Value="Center"/><Setter Property="VerticalContentAlignment" Value="Center"/><Setter Property="Cursor" Value="Hand"/><Setter Property="Background" Value="Transparent"/><Setter Property="Foreground" Value="#4E5968"/><Setter Property="Padding" Value="12,9"/><Setter Property="FontSize" Value="12"/><Setter Property="BorderThickness" Value="0"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button"><Border x:Name="B" Background="{TemplateBinding Background}" CornerRadius="10" Padding="{TemplateBinding Padding}"><ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="{TemplateBinding VerticalContentAlignment}"/></Border><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="B" Property="Opacity" Value="0.65"/></Trigger><Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="B" Property="BorderBrush" Value="#3182F6"/><Setter TargetName="B" Property="BorderThickness" Value="1"/></Trigger><Trigger Property="IsEnabled" Value="False"><Setter TargetName="B" Property="Opacity" Value="0.4"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter></Style>
  <Style TargetType="TextBox"><Setter Property="Padding" Value="12,11"/><Setter Property="Background" Value="#F2F4F6"/><Setter Property="BorderThickness" Value="0"/><Setter Property="FontSize" Value="13"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="TextBox"><Border x:Name="B" Background="{TemplateBinding Background}" CornerRadius="10" BorderThickness="1" BorderBrush="Transparent"><ScrollViewer x:Name="PART_ContentHost"/></Border><ControlTemplate.Triggers><Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="B" Property="BorderBrush" Value="#3182F6"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter></Style>
  <Style TargetType="CheckBox"><Setter Property="VerticalContentAlignment" Value="Center"/><Setter Property="Margin" Value="0,5"/><Setter Property="Foreground" Value="#6B7684"/></Style>
 </Window.Resources>
 <Border BorderBrush="#E5E8EB" BorderThickness="1"><DockPanel>
  <Grid x:Name="DragBar" DockPanel.Dock="Top" Height="60" Background="White"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
   <Image x:Name="BrandLogo" RenderOptions.BitmapScalingMode="HighQuality" Width="140" Height="42" Stretch="Uniform" HorizontalAlignment="Left" Margin="26,0,0,0" ToolTip="나날 · 하루를 차곡차곡"/>
   <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,18,0"><Button x:Name="WidgetToggle" Content="바탕화면 위젯" Background="#E8F3FF" Foreground="#1B64DA" FontWeight="SemiBold" Margin="0,0,8,0"/><Button x:Name="Pin" Content="항상 위" ToolTip="본 화면을 다른 창 위에 표시"/><Button x:Name="Settings" Content="설정"/><Button x:Name="Hide" Content="─" ToolTip="트레이로 숨기기"/><Button x:Name="Exit" Content="×" FontSize="20" ToolTip="화면 닫기 · 위젯은 유지"/></StackPanel>
  </Grid>
  <Grid DockPanel.Dock="Bottom" Height="40" Margin="28,0"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock x:Name="Status" FontSize="10" Foreground="#8B95A1" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/><TextBlock x:Name="DesktopStatus" Grid.Column="1" FontSize="10" Foreground="#8B95A1" VerticalAlignment="Center"/></Grid>
  <Grid Margin="28,24,28,0"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="24"/><ColumnDefinition Width="320"/></Grid.ColumnDefinitions><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition/></Grid.RowDefinitions>
   <StackPanel Grid.ColumnSpan="3" Margin="0,0,0,24"><TextBlock Text="오늘도, 내 속도대로." FontSize="26" FontWeight="Bold"/><TextBlock x:Name="TodayLabel" FontSize="12" Foreground="#8B95A1" Margin="0,8,0,0"/></StackPanel>
   <Border Grid.Row="1" Background="White" CornerRadius="20" Padding="24" Margin="0,0,0,4"><DockPanel>
    <Grid DockPanel.Dock="Top" Margin="0,0,0,24"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock x:Name="MonthLabel" FontSize="23" FontWeight="Bold" VerticalAlignment="Center"/><StackPanel Grid.Column="1" Orientation="Horizontal"><Button x:Name="Prev" Content="‹" FontSize="20" Padding="12,4" ToolTip="이전 달"/><Button x:Name="Today" Content="오늘" Background="#F2F4F6" Margin="4,0"/><Button x:Name="Next" Content="›" FontSize="20" Padding="12,4" ToolTip="다음 달"/></StackPanel></Grid>
    <UniformGrid DockPanel.Dock="Top" Columns="7" Margin="0,0,0,12"><TextBlock Text="일" Foreground="#F04452" HorizontalAlignment="Center" FontSize="11"/><TextBlock Text="월" Foreground="#8B95A1" HorizontalAlignment="Center" FontSize="11"/><TextBlock Text="화" Foreground="#8B95A1" HorizontalAlignment="Center" FontSize="11"/><TextBlock Text="수" Foreground="#8B95A1" HorizontalAlignment="Center" FontSize="11"/><TextBlock Text="목" Foreground="#8B95A1" HorizontalAlignment="Center" FontSize="11"/><TextBlock Text="금" Foreground="#8B95A1" HorizontalAlignment="Center" FontSize="11"/><TextBlock Text="토" Foreground="#3182F6" HorizontalAlignment="Center" FontSize="11"/></UniformGrid>
    <TextBlock DockPanel.Dock="Bottom" Text="날짜를 선택하면 오른쪽에서 일정을 확인할 수 있어요." FontSize="10" Foreground="#B0B8C1" Margin="0,16,0,0"/><ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"><Grid x:Name="MonthGrid"/></ScrollViewer>
   </DockPanel></Border>
   <ScrollViewer Grid.Row="1" Grid.Column="2" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"><StackPanel>
    <Border Background="White" CornerRadius="20" Padding="20" Margin="0,0,0,16"><StackPanel><Grid Margin="0,0,0,12"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock x:Name="DayLabel" FontWeight="Bold" FontSize="16" VerticalAlignment="Center"/><Button x:Name="Refresh" Grid.Column="1" Content="지금 동기화" FontSize="11" Padding="10,6" ToolTip="Google 캘린더와 지금 동기화"/></Grid><Button x:Name="AddEvent" Content="+ 일정 추가" Background="#E8F3FF" Foreground="#1B64DA" HorizontalAlignment="Stretch" Margin="0,0,0,12"/><StackPanel x:Name="EventList"/><Button x:Name="Connect" Content="Google 캘린더 연결하기" Background="#3182F6" Foreground="White" Margin="0,16,0,0" Padding="12,12"/></StackPanel></Border>
    <Border Background="White" CornerRadius="20" Padding="20" Margin="0,0,0,4"><StackPanel><Grid Margin="0,0,0,16"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock Text="해야 할 일" FontSize="17" FontWeight="Bold"/><TextBlock x:Name="TaskCount" Grid.Column="1" FontSize="11" Foreground="#3182F6" VerticalAlignment="Center"/></Grid>
     <Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBox Height="42" x:Name="TaskInput" ToolTip="새 할 일을 입력하고 Enter"/><Button x:Name="AddTask" Grid.Column="1" Content="+" FontSize="22" Background="#3182F6" Foreground="White" Margin="8,0,0,0" Padding="14,6"/></Grid>
     <StackPanel Orientation="Horizontal" Margin="0,10,0,8"><TextBlock Text="마감일" FontSize="11" Foreground="#8B95A1" VerticalAlignment="Center" Margin="0,0,8,0"/><DatePicker x:Name="TaskDue" Width="112" FontSize="10" ToolTip="비워 두면 기한 없음"/></StackPanel>
     <StackPanel Orientation="Horizontal" Margin="0,0,0,8"><CheckBox x:Name="TaskTimedDue" Content="마감 시간" FontSize="10" VerticalAlignment="Center" Margin="0,0,8,0"/><ContentControl x:Name="TaskTimeHost"/></StackPanel>
     <StackPanel Orientation="Horizontal" Margin="0,0,0,12"><CheckBox x:Name="TaskReminder" Content="알림" IsChecked="True" FontSize="10" VerticalAlignment="Center" Margin="0,0,8,0"/><ComboBox x:Name="TaskReminderOffset" Width="115" SelectedIndex="0"><ComboBoxItem Content="마감 시각"/><ComboBoxItem Content="5분 전"/><ComboBoxItem Content="10분 전"/><ComboBoxItem Content="30분 전"/><ComboBoxItem Content="1시간 전"/></ComboBox></StackPanel>
     <CheckBox x:Name="ShowDone" Content="완료 표시" FontSize="10" Margin="0,0,0,8"/>
     <StackPanel x:Name="TodoList"/>
    </StackPanel></Border>
   </StackPanel></ScrollViewer>
  </Grid>
 </DockPanel></Border>
</Window>
