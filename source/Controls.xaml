<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:p="clr-namespace:System.Windows.Controls.Primitives;assembly=PresentationFramework">
 <Style TargetType="CheckBox"><Setter Property="Cursor" Value="Hand"/><Setter Property="VerticalContentAlignment" Value="Center"/><Setter Property="Foreground" Value="#6B7684"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="CheckBox"><Grid Background="Transparent"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition/></Grid.ColumnDefinitions><Border x:Name="Box" Width="17" Height="17" CornerRadius="5" BorderBrush="#D1D6DB" BorderThickness="1.4" VerticalAlignment="Center"><Path x:Name="Tick" Data="M3,7 L6,10 L12,4" Stroke="White" StrokeThickness="1.8" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Visibility="Collapsed"/></Border><ContentPresenter Grid.Column="1" Margin="8,0,0,0" VerticalAlignment="Center" RecognizesAccessKey="True"/></Grid><ControlTemplate.Triggers><Trigger Property="IsChecked" Value="True"><Setter TargetName="Box" Property="Background" Value="#3182F6"/><Setter TargetName="Box" Property="BorderBrush" Value="#3182F6"/><Setter TargetName="Tick" Property="Visibility" Value="Visible"/></Trigger><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Box" Property="BorderBrush" Value="#3182F6"/></Trigger><Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Box" Property="BorderBrush" Value="#3182F6"/></Trigger><Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.4"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter></Style>
 <Style TargetType="DatePicker"><Setter Property="Height" Value="30"/><Setter Property="SelectedDateFormat" Value="Short"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="DatePicker"><Grid x:Name="PART_Root"><Border Background="#F2F4F6" CornerRadius="8" Padding="8,4"><Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><p:DatePickerTextBox x:Name="PART_TextBox" Background="Transparent" BorderThickness="0" Padding="0" FontSize="10" VerticalContentAlignment="Center"><p:DatePickerTextBox.Template><ControlTemplate TargetType="p:DatePickerTextBox"><Grid><ScrollViewer x:Name="PART_ContentHost" VerticalAlignment="Center"/><TextBlock x:Name="Hint" Text="기한 없음" Foreground="#8B95A1" VerticalAlignment="Center" IsHitTestVisible="False" Visibility="Collapsed"/></Grid><ControlTemplate.Triggers><Trigger Property="Text" Value=""><Setter TargetName="Hint" Property="Visibility" Value="Visible"/></Trigger></ControlTemplate.Triggers></ControlTemplate></p:DatePickerTextBox.Template></p:DatePickerTextBox><Button x:Name="PART_Button" Grid.Column="1" Padding="3,0" Focusable="False"><Path Width="13" Height="13" Stretch="Uniform" Data="M4,4 L20,4 L20,21 L4,21 Z M4,9 L20,9 M8,2 L8,6 M16,2 L16,6" Stroke="#8B95A1" StrokeThickness="1.6"/></Button></Grid></Border><Popup x:Name="PART_Popup" Placement="Bottom" AllowsTransparency="True" StaysOpen="False" Focusable="False"/></Grid></ControlTemplate></Setter.Value></Setter></Style>
 <Style TargetType="ComboBoxItem"><Setter Property="Padding" Value="10,9"/><Setter Property="HorizontalContentAlignment" Value="Stretch"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ComboBoxItem"><Border x:Name="Item" Background="Transparent" Padding="{TemplateBinding Padding}" CornerRadius="7"><ContentPresenter/></Border><ControlTemplate.Triggers><Trigger Property="IsHighlighted" Value="True"><Setter TargetName="Item" Property="Background" Value="#E8F3FF"/></Trigger><Trigger Property="IsSelected" Value="True"><Setter TargetName="Item" Property="Background" Value="#E8F3FF"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter></Style>
 <Style TargetType="ComboBox"><Setter Property="Background" Value="#F2F4F6"/><Setter Property="Foreground" Value="#333D4B"/><Setter Property="FontSize" Value="12"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ComboBox"><Grid><ToggleButton Focusable="False" IsChecked="{Binding IsDropDownOpen,Mode=TwoWay,RelativeSource={RelativeSource TemplatedParent}}"><ToggleButton.Template><ControlTemplate TargetType="ToggleButton"><Border Background="#F2F4F6" CornerRadius="10"><Path Data="M0,0 L4,4 L8,0" Width="8" Height="4" Stroke="#8B95A1" StrokeThickness="1.4" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,12,0"/></Border></ControlTemplate></ToggleButton.Template></ToggleButton><ContentPresenter x:Name="Display" Content="{TemplateBinding SelectionBoxItem}" ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}" Margin="12,8,32,8" VerticalAlignment="Center" IsHitTestVisible="False"/><TextBox x:Name="PART_EditableTextBox" Visibility="Hidden" Background="Transparent" BorderThickness="0" Margin="10,2,30,2" Padding="0" VerticalContentAlignment="Center" Style="{x:Null}"/><Popup x:Name="PART_Popup" Placement="Bottom" IsOpen="{TemplateBinding IsDropDownOpen}" AllowsTransparency="True" Focusable="False"><Border MinWidth="{Binding ActualWidth,RelativeSource={RelativeSource TemplatedParent}}" Background="White" BorderBrush="#E5E8EB" BorderThickness="1" CornerRadius="10" Padding="5"><ScrollViewer MaxHeight="230" CanContentScroll="True"><ItemsPresenter/></ScrollViewer></Border></Popup></Grid><ControlTemplate.Triggers><Trigger Property="IsEditable" Value="True"><Setter TargetName="PART_EditableTextBox" Property="Visibility" Value="Visible"/><Setter TargetName="Display" Property="Visibility" Value="Hidden"/></Trigger><Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.45"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter></Style>
</ResourceDictionary>
