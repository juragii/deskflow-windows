<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="DeskFlow · 바탕화면 캘린더" Width="900" Height="760" MinWidth="560" MinHeight="400" WindowStyle="None" ResizeMode="NoResize" AllowsTransparency="True" Background="Transparent" ShowInTaskbar="False" ShowActivated="False" FontFamily="Malgun Gothic" Foreground="#191F28" UseLayoutRounding="True">
 <Grid><Border x:Name="WidgetSurface" CornerRadius="22" BorderThickness="1" BorderBrush="#409AA5B1" Padding="16,12"><Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
  <Grid x:Name="WidgetDrag" Background="Transparent" Margin="0,0,0,6"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel Orientation="Horizontal" VerticalAlignment="Center"><TextBlock Text="deskflow" FontFamily="Segoe UI" FontWeight="SemiBold" FontSize="11" Foreground="#8B95A1"/><TextBlock x:Name="WidgetState" Visibility="Collapsed"/></StackPanel><StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Top"><Button x:Name="WidgetFit" Content="맞춤" FontSize="10" Padding="7,3" ToolTip="달력과 모든 할 일이 한눈에 보이도록 크기 자동 맞춤"/><Button x:Name="WidgetLock" Content="잠금" FontSize="10" Padding="7,3"/><Button x:Name="WidgetOpen" Content="열기" FontSize="10" Padding="7,3"/><Button x:Name="WidgetHide" Content="×" FontSize="16" Padding="7,0"/></StackPanel></Grid>
  <Viewbox x:Name="WidgetFitView" Grid.Row="1" Stretch="Uniform" StretchDirection="Both" HorizontalAlignment="Stretch" VerticalAlignment="Top"><Grid x:Name="WidgetContent" Width="860" Height="640"><Grid.ColumnDefinitions><ColumnDefinition Width="4*"/><ColumnDefinition Width="14"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
   <Grid><Grid.RowDefinitions><RowDefinition Height="50"/><RowDefinition Height="26"/><RowDefinition/></Grid.RowDefinitions><Grid Margin="0,0,0,14"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock x:Name="WidgetMonth" FontSize="23" FontWeight="Bold"/><StackPanel Grid.Column="1" Orientation="Horizontal"><Button x:Name="WidgetPrev" Content="‹" FontSize="18" Padding="8,3"/><Button x:Name="WidgetToday" Content="오늘" FontSize="10" Padding="8,3"/><Button x:Name="WidgetNext" Content="›" FontSize="18" Padding="8,3"/></StackPanel></Grid>
   <UniformGrid Grid.Row="1" Columns="7"><TextBlock Text="일" Foreground="#F04452" HorizontalAlignment="Center" FontSize="10"/><TextBlock Text="월" Foreground="#8B95A1" HorizontalAlignment="Center" FontSize="10"/><TextBlock Text="화" Foreground="#8B95A1" HorizontalAlignment="Center" FontSize="10"/><TextBlock Text="수" Foreground="#8B95A1" HorizontalAlignment="Center" FontSize="10"/><TextBlock Text="목" Foreground="#8B95A1" HorizontalAlignment="Center" FontSize="10"/><TextBlock Text="금" Foreground="#8B95A1" HorizontalAlignment="Center" FontSize="10"/><TextBlock Text="토" Foreground="#3182F6" HorizontalAlignment="Center" FontSize="10"/></UniformGrid><UniformGrid x:Name="WidgetDays" Grid.Row="2" Columns="7" Rows="6"/></Grid>
   <Border Grid.Column="2" BorderBrush="#30AAB2BB" BorderThickness="1,0,0,0" Padding="12,4,0,0"><StackPanel><TextBlock x:Name="WidgetDay" FontSize="13" FontWeight="Bold" Margin="0,0,0,14"/><StackPanel x:Name="WidgetAgenda"/><StackPanel x:Name="WidgetTaskSection" Margin="0,20,0,0"><TextBlock x:Name="WidgetTaskHeading" Text="남은 할 일" FontSize="13" FontWeight="Bold" Margin="0,0,0,12"/><StackPanel x:Name="WidgetTasks"/></StackPanel></StackPanel></Border>
  </Grid></Viewbox>
  <Grid Grid.Row="2" Margin="0,6,12,0"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock x:Name="WidgetSync" FontSize="9" Foreground="#8B95A1" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/><Button x:Name="WidgetRefresh" Grid.Column="1" Content="동기화" FontSize="10" Padding="7,5"/></Grid>
 </Grid></Border><Thumb x:Name="WidgetResize" Width="24" Height="24" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,5,5" Cursor="SizeNWSE" ToolTip="드래그하여 위젯 크기 조절"><Thumb.Template><ControlTemplate TargetType="Thumb"><Grid Background="Transparent"><Path Data="M7,19 L19,7 M12,19 L19,12 M17,19 L19,17" Stroke="#8B95A1" StrokeThickness="1.5"/></Grid></ControlTemplate></Thumb.Template></Thumb></Grid>
</Window>