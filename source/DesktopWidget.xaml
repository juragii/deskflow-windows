<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="DeskFlow · 바탕화면 캘린더" Width="372" Height="590" WindowStyle="None" ResizeMode="NoResize" AllowsTransparency="True" Background="Transparent" ShowInTaskbar="False" ShowActivated="False" FontFamily="Malgun Gothic" Foreground="#191F28" UseLayoutRounding="True">
 <Border x:Name="WidgetSurface" CornerRadius="22" BorderThickness="1" BorderBrush="#409AA5B1" Padding="22,18"><DockPanel>
  <Grid x:Name="WidgetDrag" DockPanel.Dock="Top" Background="Transparent" Margin="0,0,0,20"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="deskflow" FontFamily="Segoe UI" FontWeight="Bold" FontSize="15" Foreground="#3182F6"/><TextBlock x:Name="WidgetState" FontSize="9" Foreground="#8B95A1" Margin="0,4,0,0"/></StackPanel><StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Top"><Button x:Name="WidgetLock" Content="잠금" FontSize="10" Padding="8,6" ToolTip="클릭하여 위젯 이동 잠금 전환"/><Button x:Name="WidgetOpen" Content="열기" FontSize="10" Padding="8,6" ToolTip="본 화면 열기"/><Button x:Name="WidgetHide" Content="×" FontSize="16" Padding="8,2" ToolTip="위젯 숨기기"/></StackPanel></Grid>
  <Grid DockPanel.Dock="Bottom" Margin="0,12,0,0"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock x:Name="WidgetSync" FontSize="9" Foreground="#8B95A1" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/><Button x:Name="WidgetRefresh" Grid.Column="1" Content="동기화" FontSize="10" Padding="7,5" ToolTip="Google 캘린더와 지금 동기화"/></Grid>
  <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"><StackPanel>
   <Grid Margin="0,0,0,18"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock x:Name="WidgetMonth" FontSize="23" FontWeight="Bold"/><StackPanel Grid.Column="1" Orientation="Horizontal"><Button x:Name="WidgetPrev" Content="‹" FontSize="18" Padding="8,3"/><Button x:Name="WidgetToday" Content="오늘" FontSize="10" Padding="8,3"/><Button x:Name="WidgetNext" Content="›" FontSize="18" Padding="8,3"/></StackPanel></Grid>
   <UniformGrid Columns="7" Margin="0,0,0,8"><TextBlock Text="일" Foreground="#F04452" HorizontalAlignment="Center" FontSize="10"/><TextBlock Text="월" Foreground="#8B95A1" HorizontalAlignment="Center" FontSize="10"/><TextBlock Text="화" Foreground="#8B95A1" HorizontalAlignment="Center" FontSize="10"/><TextBlock Text="수" Foreground="#8B95A1" HorizontalAlignment="Center" FontSize="10"/><TextBlock Text="목" Foreground="#8B95A1" HorizontalAlignment="Center" FontSize="10"/><TextBlock Text="금" Foreground="#8B95A1" HorizontalAlignment="Center" FontSize="10"/><TextBlock Text="토" Foreground="#3182F6" HorizontalAlignment="Center" FontSize="10"/></UniformGrid>
   <UniformGrid x:Name="WidgetDays" Columns="7" Rows="6"/>
   <Border BorderBrush="#30AAB2BB" BorderThickness="0,1,0,0" Margin="0,16,0,0" Padding="0,18,0,0"><StackPanel><TextBlock x:Name="WidgetDay" FontSize="13" FontWeight="Bold" Margin="0,0,0,10"/><StackPanel x:Name="WidgetAgenda"/></StackPanel></Border>
   <StackPanel x:Name="WidgetTaskSection" Margin="0,14,0,0"><TextBlock Text="남은 할 일" FontSize="11" Foreground="#8B95A1" Margin="0,0,0,8"/><StackPanel x:Name="WidgetTasks"/></StackPanel>
  </StackPanel></ScrollViewer>
 </DockPanel></Border>
</Window>
